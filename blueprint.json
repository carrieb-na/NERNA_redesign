{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "NERNA website redesign demo",
		"description": "The new nerna.org theme with sample pages, running in WordPress Playground.",
		"author": "carrieb-na",
		"categories": [
			"Theme"
		]
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.2",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"steps": [
		{
			"step": "installTheme",
			"themeData": {
				"resource": "git:directory",
				"url": "https://github.com/carrieb-na/NERNA_redesign",
				"ref": "main",
				"path": "nerna-theme"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "crouton"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "mayo-events-manager"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; require get_theme_file_path( 'demo/setup.php' ); nerna_demo_setup();"
		}
	]
}
